# Public site
NEXT_PUBLIC_SITE_URL=https://yuk-jadi-legal.vercel.app

# Firebase Web SDK (public identifiers)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase App Check — optional for now
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# Local development only. Never set true in production.
NEXT_PUBLIC_FIREBASE_APP_CHECK_DEBUG=false

# Firebase Admin SDK — server only, never NEXT_PUBLIC
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep as one env value; escaped \\n is supported.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Cloudinary signed upload — server only
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional hardening for /api/admin/cloudinary-signature.
# Keep false until App Check is intentionally configured and verified.
FIREBASE_APP_CHECK_ENFORCE_CUSTOM_API=false

# Optional Google Analytics 4 (example: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional lead email notification via Resend.
# Leave all three empty if email notification is not needed yet.
