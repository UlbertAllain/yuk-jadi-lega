rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /siteSettings/{docId} {
      allow read: if docId == 'main';
      allow write: if isAdmin() && docId == 'main';
    }

    match /serviceCategories/{docId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /services/{docId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /articles/{docId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /testimonials/{docId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /partners/{docId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /faqs/{docId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /teamMembers/{docId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /caseStudies/{docId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name',
          'whatsapp',
          'email',
          'serviceSlug',
          'message',
          'source',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() >= 8
        && request.resource.data.whatsapp.size() <= 30
        && (!('email' in request.resource.data)
          || (request.resource.data.email is string
            && request.resource.data.email.size() <= 160))
        && (!('serviceSlug' in request.resource.data)
          || (request.resource.data.serviceSlug is string
            && request.resource.data.serviceSlug.size() <= 120))
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3
        && request.resource.data.message.size() <= 3000
        && request.resource.data.status == 'baru'
        && request.resource.data.source == 'website-form'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow read, update, delete: if isAdmin();
    }
  }
}
