rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /siteSettings/{docId} {
      allow read: if docId == 'main';
      allow write: if isAdmin() && docId == 'main';
    }

    match /serviceCategories/{docId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /services/{docId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /articles/{docId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /testimonials/{docId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /partners/{docId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /faqs/{docId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    match /teamMembers/{docId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }


    match /leads/{leadId} {
      // Public submissions go through /api/leads using Firebase Admin SDK.
      // Browser clients cannot create leads directly anymore.
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }
  }
}
